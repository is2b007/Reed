{
  "name": "@reed/editor",
  "productName": "Reed",
  "version": "0.2.2",
  "description": "Offline branching dialogue and localization workspace for game development",
  "private": true,
  "license": "MPL-2.0",
  "type": "module",
  "main": ".webpack/main",
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "make:mac": "electron-forge make --platform=darwin --arch=arm64",
    "make:windows": "electron-forge make --platform=win32 --arch=x64",
    "make:desktop": "pnpm make:mac && pnpm make:windows",
    "build": "electron-forge package",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.2.6",
    "@fontsource/ibm-plex-sans": "^5.2.6",
    "@fontsource/source-serif-4": "^5.2.6",
    "@reed/core": "workspace:*",
    "@reed/schema": "workspace:*",
    "@xyflow/react": "^12.11.2",
    "better-sqlite3": "12.10.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@electron-forge/cli": "7.8.3",
    "@electron-forge/maker-dmg": "7.8.3",
    "@electron-forge/maker-zip": "7.8.3",
    "@electron-forge/plugin-auto-unpack-natives": "7.8.3",
    "@electron-forge/plugin-fuses": "7.8.3",
    "@electron-forge/plugin-webpack": "7.8.3",
    "@electron-forge/shared-types": "7.8.3",
    "@electron/fuses": "1.8.0",
    "@electron/rebuild": "4.0.4",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "css-loader": "^7.1.2",
    "electron": "41.10.2",
    "node-loader": "^2.1.0",
    "style-loader": "^4.0.0",
    "ts-loader": "^9.5.2",
    "webpack": "^5.101.3",
    "webpack-cli": "^6.0.1"
  }
}
